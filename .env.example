# Copy to .env and set WEBHOOK_SECRET (and SECRET_KEY for anything beyond local use):
#   copy .env.example .env        (Windows)   /   cp .env.example .env
# docker compose overrides DJANGO_SETTINGS_MODULE, DATABASE_URL, ALLOWED_HOSTS, SEED_ON_START
# and LOG_FORMAT for the web container (see docker-compose.yml).

# --- Django ---
# local = runserver/dev, prod = Docker image (DEBUG off, whitenoise, security headers)
DJANGO_SETTINGS_MODULE=config.settings.local
# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Ignored by prod settings (always False there)
DEBUG=True
# Comma-separated host names this app may serve (required in prod)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Postgres from docker-compose "db" (host port 5433; inside compose the web service uses db:5432)
DATABASE_URL=postgres://eve:eve@localhost:5433/eve

# --- Auth (JWT lifetimes) ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Business rules ---
MAX_BOOKING_DAYS_AHEAD=90
# Probability (0-1) that POST /payments/ without an explicit outcome succeeds
PAYMENT_SUCCESS_RATE=0.8

# --- Payment webhook ---
# REQUIRED. Shared HMAC secret with the payment provider (scripts/send_webhook.py reads it too).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=change-me-webhook

# --- Seed data (dev only) ---
# Admin created by `manage.py seed_data` (and on container start when SEED_ON_START=true)
SEED_ADMIN_EMAIL=admin@eve.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ON_START=false

# --- Logging ---
# text (readable, default locally) | json (one object per line, default in prod/Docker)
LOG_FORMAT=text
LOG_LEVEL=INFO

# --- Server (Docker) ---
GUNICORN_WORKERS=3

# --- HTTPS deployment only (prod settings). Leave unset/false for local Docker over HTTP. ---
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
